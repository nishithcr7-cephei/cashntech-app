<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Dark status-bar icons on light headers (Android 6+). -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:textColor">#191D23</item>
        <item name="android:textColorPrimary">#191D23</item>
        <item name="android:textColorHint">#9E9E9E</item>
        <item name="android:textColorSecondary">#191D23</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

</resources>
